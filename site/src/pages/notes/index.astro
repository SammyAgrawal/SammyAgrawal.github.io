---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import FormattedDate from '../../components/FormattedDate.astro';

const notes = (await getCollection('notes')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const topics: string[] = [...new Set(notes.map((n) => n.data.topic))].sort();
const tags: string[] = [...new Set(notes.flatMap((n) => n.data.tags))].sort();
const tagCounts: Record<string, number> = Object.fromEntries(
	tags.map((t) => [t, notes.filter((n) => n.data.tags.includes(t)).length]),
);

const topicHero: Record<string, any> = {};
for (const topic of topics) {
	const first = notes.find((n) => n.data.topic === topic && n.data.heroImage);
	if (first) topicHero[topic] = first.data.heroImage;
}

const topicCounts: Record<string, number> = Object.fromEntries(
	topics.map((t) => [t, notes.filter((n) => n.data.topic === t).length]),
);

const recent = notes.slice(0, 5);
---

<BaseLayout
	title="Notes — Sammy Agrawal"
	description="Reading notes organized by topic, cross-linked by tag."
>
	<main class="app-container pt-36">
		<h1 class="text-6xl pb-8 font-bold">Notes</h1>
		<p class="md:w-2/3 text-lg leading-[2rem]">
			Summaries and annotations from things I'm reading — papers, textbooks, books. Organized by
			topic, cross-linked by tag.
		</p>
	</main>
	{tags.length > 0 && (
		<section class="app-container py-12">
			<ul class="flex flex-wrap gap-3 mt-6">
				{tags.map((tag) => (
					<li>
						<a
							href={`/notes/tags/${tag}/`}
							class="inline-block px-3 py-1 rounded-full border border-foreground/30 dark:border-foreground-dark/30 hover:bg-foreground/10 dark:hover:bg-foreground-dark/10 transition-colors text-sm"
						>
							#{tag} <span class="opacity-60">({tagCounts[tag]})</span>
						</a>
					</li>
				))}
			</ul>
		</section>
	)}

	{recent.length > 0 && (
		<section class="app-container py-12">
			<h2 class="section-title">Recent</h2>
			<ul class="divide-y divide-foreground/15 dark:divide-foreground-dark/15">
				{recent.map((note) => {
					const slug = note.id.split('/').slice(-1)[0];
					return (
						<li class="py-4">
							<a
								href={`/notes/${note.data.topic}/${slug}/`}
								class="text-lg hover:text-primary dark:hover:text-primary-dark hover:underline underline-offset-4"
							>
								{note.data.title}
							</a>
							<div class="text-sm opacity-70 mt-1">
								<FormattedDate date={note.data.pubDate} /> · {note.data.topic}
							</div>
						</li>
					);
				})}
			</ul>
		</section>
	)}

	<section class="app-container py-12">
		<h2 class="section-title">Topics</h2>
		{
			topics.length === 0 ? (
				<p class="opacity-70">No notes yet.</p>
			) : (
				<ul class="posts-grid-container">
					{topics.map((topic) => (
						<li>
							<Card
								href={`/notes/${topic}/`}
								title={topic}
								description={`${topicCounts[topic]} note${topicCounts[topic] === 1 ? '' : 's'}`}
								heroImage={topicHero[topic]}
							/>
						</li>
					))}
				</ul>
			)
		}
	</section>

</BaseLayout>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Card from '../../../components/Card.astro';

export async function getStaticPaths() {
	const notes = await getCollection('notes');
	const topics = [...new Set(notes.map((n) => n.data.topic))];
	return topics.map((topic) => ({
		params: { topic },
		props: {
			topic,
			notes: notes
				.filter((n) => n.data.topic === topic)
				.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

const { topic, notes } = Astro.props;
---

<BaseLayout
	title={`${topic} — Notes — Sammy Agrawal`}
	description={`Notes on ${topic}.`}
>
	<main class="app-container pt-36">
		<p class="text-sm opacity-70 mb-2">
			<a href="/notes/" class="hover:underline underline-offset-4">Notes</a> /
		</p>
		<h1 class="text-6xl pb-8 font-bold capitalize">{topic}</h1>
	</main>
	<section class="app-container py-12">
		<ul class="posts-grid-container">
			{
				notes.map((note) => {
					const slug = note.id.split('/').slice(-1)[0];
					return (
						<li>
							<Card
								href={`/notes/${topic}/${slug}/`}
								title={note.data.title}
								description={note.data.description}
								pubDate={note.data.pubDate}
								heroImage={note.data.heroImage}
								tags={note.data.tags}
							/>
						</li>
					);
				})
			}
		</ul>
	</section>
</BaseLayout>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';

const [tags, notes, writing, projects] = await Promise.all([
	getCollection('tags'),
	getCollection('notes'),
	getCollection('writing'),
	getCollection('projects'),
]);

function countUsages(tagId: string) {
	const inNotes = notes.filter((n) => n.data.tags.some((t) => t.id === tagId)).length;
	const inWriting = writing.filter((w) => w.data.tags.some((t) => t.id === tagId)).length;
	const inProjects = projects.filter((p) => p.data.tags.some((t) => t.id === tagId)).length;
	return { inNotes, inWriting, inProjects, total: inNotes + inWriting + inProjects };
}

const tagsWithCounts = tags
	.map((t) => ({ entry: t, counts: countUsages(t.id) }))
	.sort((a, b) => a.entry.data.title.localeCompare(b.entry.data.title));

const themes = tagsWithCounts.filter((t) => t.entry.data.kind === 'theme');
const simpleTags = tagsWithCounts.filter((t) => t.entry.data.kind === 'tag');
---

<BaseLayout
	title="Tags — Sammy Agrawal"
	description="Themes and tags that cut across notes, writing, and projects."
>
	<main class="app-container pt-36">
		<h1 class="text-6xl pb-8 font-bold">Tags</h1>
		<p class="md:w-2/3 text-lg leading-[2rem]">
			Cross-cutting themes and tags. Themes are long-running threads (e.g. the Prosperity Project)
			that group notes, writing, and projects together. Tags are smaller labels.
		</p>
	</main>

	{themes.length > 0 && (
		<section class="app-container py-12">
			<h2 class="section-title">Themes</h2>
			<ul class="posts-grid-container">
				{themes.map(({ entry, counts }) => (
					<li>
						<Card
							href={`/tags/${entry.id}/`}
							title={entry.data.title}
							description={entry.data.description ?? `${counts.total} entries`}
							heroImage={entry.data.heroImage}
						/>
					</li>
				))}
			</ul>
		</section>
	)}

	{simpleTags.length > 0 && (
		<section class="app-container py-12">
			<h2 class="section-title">Tags</h2>
			<ul class="flex flex-wrap gap-3 mt-6">
				{simpleTags.map(({ entry, counts }) => (
					<li>
						<a
							href={`/tags/${entry.id}/`}
							class="inline-block px-3 py-1 rounded-full border border-foreground/30 dark:border-foreground-dark/30 hover:bg-foreground/10 dark:hover:bg-foreground-dark/10 transition-colors text-sm"
						>
							#{entry.id} <span class="opacity-60">({counts.total})</span>
						</a>
					</li>
				))}
			</ul>
		</section>
	)}

	{tagsWithCounts.length === 0 && (
		<section class="app-container py-12">
			<p class="opacity-70">No tags yet.</p>
		</section>
	)}
</BaseLayout>

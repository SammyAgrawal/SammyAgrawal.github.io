---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Sample Project — Sammy Agrawal" description="Placeholder project page.">
	<main class="app-container pt-36 pb-24 max-w-3xl">
		<p class="text-sm opacity-70 mb-2">
			<a href="/projects/" class="hover:underline underline-offset-4">← Projects</a>
		</p>
		<h1 class="text-5xl font-bold pb-6">Sample Project</h1>
		<div
			class="prose prose-neutral prose-lg dark:prose-invert"
		>
			<p>
				This is a placeholder project page. Each project lives in its own folder under{' '}
				<code>src/pages/projects/&lt;name&gt;/</code> and can be styled however you want — drop in
				D3, a React island, an iframe to a FastAPI app, custom CSS, etc. The only requirement is
				that the gallery entry in <code>src/content/projects/&lt;name&gt;.md</code> points its{' '}
				<code>link</code> field at this route.
			</p>
		</div>
	</main>
</BaseLayout>

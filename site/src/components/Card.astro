---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';

interface Props {
	href: string;
	title: string;
	description?: string;
	pubDate?: Date;
	heroImage?: ImageMetadata;
	external?: boolean;
	eyebrow?: string;
	tags?: string[];
}

const {
	href,
	title,
	description,
	pubDate,
	heroImage,
	external = false,
	eyebrow,
	tags = [],
} = Astro.props;
---

<a
	href={href}
	target={external ? '_blank' : undefined}
	rel={external ? 'noopener noreferrer' : undefined}
	class="flex flex-col gap-4 pb-8 h-full group transition-colors"
>
	{
		heroImage && (
			<Image
				src={heroImage}
				alt={title}
				class="object-cover rounded-xl aspect-video w-full"
			/>
		)
	}
	{eyebrow && (
		<p class="uppercase text-xs tracking-wider opacity-70 -mb-2">{eyebrow}</p>
	)}
	<h4
		class="text-2xl font-semibold group-hover:text-primary dark:group-hover:text-primary-dark group-hover:underline transition-colors"
	>
		{title}{external && <span class="opacity-60"> ↗</span>}
	</h4>
	{description && <p class="line-clamp-3 opacity-80">{description}</p>}
	{
		tags.length > 0 && (
			<div class="flex flex-wrap gap-2 text-xs opacity-70">
				{tags.map((tag) => (
					<span>#{tag}</span>
				))}
			</div>
		)
	}
	{
		pubDate && (
			<p class="uppercase text-sm mt-auto tracking-tight opacity-80">
				<FormattedDate date={pubDate} />
			</p>
		)
	}
</a>

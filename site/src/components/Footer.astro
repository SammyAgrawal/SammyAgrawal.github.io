---
import { SITE_BASE, SocialLinks, WebsiteLinks } from '../consts';

const today = new Date();
---

<footer>
	<div
		class="app-container grid md:grid-cols-3 gap-12 py-16 border-t border-foreground/30 dark:border-foreground-dark/30"
	>
		<div>
			<a
				href={`${SITE_BASE}/`}
				class="block w-fit text-xl font-semibold tracking-tight hover:opacity-75 transition-opacity"
				aria-label="Home"
			>
				Sammy Agrawal
			</a>
		</div>
		<div>
			<h3 class="font-semibold text-2xl">Pages</h3>
			<div class="flex flex-wrap gap-4 mt-4">
				{
					WebsiteLinks.filter((link) => link.name !== 'Home').map((link) => (
						<a class="text-lg hover:underline underline-offset-4" href={`${SITE_BASE}/${link.url}`}>
							{link.name}
						</a>
					))
				}
				<a
					href="/rss.xml"
					class="text-lg hover:underline underline-offset-4"
					aria-label="RSS Feed"
				>
					RSS
				</a>
			</div>
		</div>
		<div>
			<h3 class="font-semibold text-2xl">Socials</h3>
			<div class="flex flex-wrap gap-4 mt-4">
				{
					SocialLinks.map((link) => (
						<a
							class="text-lg hover:underline underline-offset-4"
							href={link.url}
							target="_blank"
							rel="noopener noreferrer"
						>
							{link.name}
						</a>
					))
				}
			</div>
		</div>
	</div>
	<div class="app-container flex justify-between items-center pb-6 text-center">
		<p class="text-left md:text-center w-full opacity-70 text-sm">
			&copy; {today.getFullYear()} Sammy Agrawal
		</p>
	</div>
</footer>
